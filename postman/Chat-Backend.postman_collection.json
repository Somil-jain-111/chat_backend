{
  "info": {
    "name": "Chat Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "userAId",
      "value": ""
    },
    {
      "key": "userBId",
      "value": ""
    },
    {
      "key": "chatId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    },
    {
      "key": "groupMemberId",
      "value": ""
    },
    {
      "key": "groupTitle",
      "value": "Engineering Team"
    }
  ],
  "item": [
    {
      "name": "Create chat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userAId\":\"{{userAId}}\",\"userBId\":\"{{userBId}}\"}"
        },
        "url": "{{baseUrl}}/chat/create"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "pm.collectionVariables.set('chatId', pm.response.json().chatId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Send message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"senderId\":\"{{userAId}}\",\"text\":\"Hello from Postman\"}"
        },
        "url": "{{baseUrl}}/chat/{{chatId}}/message/send"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(201);",
              "pm.collectionVariables.set('messageId', pm.response.json().messageId);"
            ]
          }
        }
      ]
    },
    {
      "name": "List messages",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/chat/{{chatId}}/messages?limit=50"
      }
    },
    {
      "name": "Mark message read",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\":\"{{userBId}}\"}"
        },
        "url": "{{baseUrl}}/chat/{{chatId}}/message/{{messageId}}/read"
      }
    },
    {
      "name": "Update last seen",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\":\"{{userBId}}\",\"messageId\":\"{{messageId}}\"}"
        },
        "url": "{{baseUrl}}/chat/{{chatId}}/lastseen"
      }
    },
    {
      "name": "List user chats",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/user/{{userAId}}/chats"
      }
    },
    {
      "name": "Create group chat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"creatorId\":\"{{userAId}}\",\"title\":\"{{groupTitle}}\",\"memberIds\":[\"{{userBId}}\",\"{{groupMemberId}}\"]}"
        },
        "url": "{{baseUrl}}/chat/group"
      }
    },
    {
      "name": "Rename group chat",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"actorId\":\"{{userAId}}\",\"title\":\"Updated {{groupTitle}}\"}"
        },
        "url": "{{baseUrl}}/chat/{{chatId}}/group"
      }
    },
    {
      "name": "Add group member",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"actorId\":\"{{userAId}}\",\"userId\":\"{{groupMemberId}}\"}"
        },
        "url": "{{baseUrl}}/chat/{{chatId}}/group/members"
      }
    },
    {
      "name": "Remove group member",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"actorId\":\"{{userAId}}\"}"
        },
        "url": "{{baseUrl}}/chat/{{chatId}}/group/members/{{groupMemberId}}"
      }
    },
    {
      "name": "Edit message",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"senderId\":\"{{userAId}}\",\"text\":\"Edited message\"}"
        },
        "url": "{{baseUrl}}/chat/{{chatId}}/message/{{messageId}}"
      }
    },
    {
      "name": "Delete message",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"senderId\":\"{{userAId}}\"}"
        },
        "url": "{{baseUrl}}/chat/{{chatId}}/message/{{messageId}}"
      }
    }
  ]
}
